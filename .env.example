# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studentvoute
DB_USER=root
DB_PASSWORD=

# AWS Rekognition (use an IAM role or AWS credential provider chain; do not commit keys)
AWS_REGION=us-east-1
AWS_REKOGNITION_COLLECTION=your-rekognition-collection

# Filebase S3-compatible storage (optional)
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_S3_ENDPOINT=https://s3.filebase.com
FILEBASE_BUCKET=

# Local Ganache / blockchain (optional; use a disposable test account)
GANACHE_URL=http://127.0.0.1:7545
BLOCKCHAIN_PRIVATE_KEY=
